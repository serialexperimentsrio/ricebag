{
  "name": "ricebag",
  "version": "0.1.4",
  "description": "A React component library with CSS custom property theming",
  "keywords": [
    "react",
    "ui",
    "components",
    "component-library",
    "css-variables",
    "theming"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "Rio",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild-css-modules-plugin": "^3.1.5",
    "typescript": "^6"
  }
}
